+function Get-InstallerHostId {
+ if($InstallerProcessId -eq 0){return 0}
+ $self=Get-CimInstance Win32_Process -Filter "ProcessId=$PID" -ErrorAction Stop
+ if(!$self -or [int]$self.ParentProcessId -ne $InstallerProcessId){throw 'Invalid installer parent process'}
+ return $InstallerProcessId
+}
+function Test-AniimoGameProcess($process,[int]$hostId) {
+ return ($process.Name -match '^Aniimo.*\.exe$' -and [int]$process.ProcessId -ne $hostId)
+}
